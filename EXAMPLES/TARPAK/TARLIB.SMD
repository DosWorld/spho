(* USTAR tar header parsing/building, shared by TARPAK.SMD/TARUNPAK.SMD.
   IMPORTs SYSTEM/FILES/OUT directly (unlike EXAMPLES/LZSS/LZPLIB.SMD,
   whose own procedures never call anything outside pure computation) --
   this module's own Error*/PadTo512*/SkipTo512*/CopyRaw*/
   ClearChksumField* additions (moved here from TARPAK.SMD/TARUNPAK.SMD
   to remove real duplication between the two, see each addition's own
   header comment) genuinely need Out_String/Halt/BlockRead/
   BlockWrite/FilePos/Seek, which the original IsZeroBlock*/
   ParseOctal*/FormatOctal*/HeaderChecksum* never did (all four are
   pure computation over an already-in-memory buffer). This module is
   compiled STANDALONE by its own Makefile rule (TARLIB.SHD:
   TARLIB.SMD $(SPHO), no caller IMPORT chain involved), so it needs
   this IMPORT of its own now, not a "caller already imported it"
   assumption -- TARPAK.SMD/TARUNPAK.SMD both already import
   SYSTEM/FILES/OUT/TARLIB themselves regardless, so nothing about
   their own IMPORT lists needs to change for THIS reason (though both
   also now IMPORT CMDLINE directly, see below).

   Command-line parsing (SkipBlanks/GetToken/the PSP-tail-setup
   boilerplate) does NOT live here -- an earlier draft added a
   TARLIB-local GetTokenPlain/SkipBlanksPlain/StartTarCmdLine/
   TarCmdState (a second, no-quote-support command-line module,
   parallel to and separate from EXAMPLES/LIB/CMDLINE.SMD's own
   quote-aware equivalents), reasoning that TARPAK/TARUNPAK's own
   former token scanner had no quote support and neither program's
   real usage (a bare input/output filename) ever needed it. That
   reasoning was sound on its own terms, but keeping a SECOND
   command-line module around, distinct from the one every other
   EXAMPLES/ program uses, was exactly the kind of duplication this
   whole consolidation effort exists to remove -- TARPAK.SMD/
   TARUNPAK.SMD now IMPORT CMDLINE directly and use its own CmdState/
   StartCmdLine/SkipBlanks/GetToken instead, same as every other
   migrated example. CMDLINE.GetToken's own quote support is a strict
   superset of what TARPAK/TARUNPAK ever needed, so nothing about
   their own observable behavior changes.

   USTAR header layout (DOCS -- POSIX ustar, 512 bytes total):
     name[100] mode[8] uid[8] gid[8] size[12] mtime[12] chksum[8]
     typeflag[1] linkname[100] magic[6] version[2] uname[32] gname[32]
     devmajor[8] devminor[8] prefix[155] pad[12]
   size/mode/uid/gid/mtime/chksum are octal ASCII, NUL or space
   terminated/padded. Content is padded to a 512-byte boundary; the
   archive ends with two consecutive all-zero 512-byte blocks.

   Member sizes are a genuine LONGINT (32-bit) pair here (DOCS/TRBUG.MD)
   -- ParseOctal*/FormatOctal* both work in lo/hi WORD pairs (register-
   pair MOVES, DOCS/SPHINX.MD S11: SPHINX has no native 32-bit
   arithmetic), matching LZPLIB.SMD's own lzp_compress_fp*/
   lzp_decompress_fp* LONGINT limit/size. BlockRead/BlockWrite
   themselves are still WORD-per-call (their own len parameter), so a
   member's content is still copied/(de)compressed CopyChunk-sized
   piece at a time either way -- only the per-member TOTAL size
   tracking is now a real 32-bit value, not truncated to 16 bits. *)
MODULE TARLIB;

IMPORT SYSTEM, FILES, OUT;

CONST
  BlockSize = 512;
  ChksumOfs = 148;   (* byte offset of TarHeader.chksum within the 512-
    byte header -- name[100]+mode[8]+uid[8]+gid[8]+size[12]+mtime[12] =
    100+8+8+8+12+12 = 148. Hardcoded rather than derived from ADR() of
    a RECORD field, since ADR() only accepts a real [seg:base].Type.field
    memory operand (an actual instance), not a bare type-relative
    offset (DOCS/SPHINX.MD's own ADR() entry) -- USTAR's own layout is
    fixed, so this never needs to track a TarHeader field reorder. *)

TYPE
  TarHeader* = RECORD
    name     : BYTE[100];
    mode     : BYTE[8];
    uid      : BYTE[8];
    gid      : BYTE[8];
    size     : BYTE[12];
    mtime    : BYTE[12];
    chksum   : BYTE[8];
    typeflag : BYTE;
    linkname : BYTE[100];
    magic    : BYTE[6];
    version  : BYTE[2];
    uname    : BYTE[32];
    gname    : BYTE[32];
    devmajor : BYTE[8];
    devminor : BYTE[8];
    prefix   : BYTE[155];
    pad      : BYTE[12]
  END;

(* IsZeroBlock*: TRUE if all BlockSize bytes at ptr are zero -- the
   end-of-archive marker (two of these in a row) and also used to
   detect EOF-of-archive on a short/final read. *)
PROCEDURE IsZeroBlock*(ptr : WORD) : BOOLEAN; NEAR;
USES SI;
VAR i : WORD; c : BYTE;
BEGIN
  SI := ptr;
  i := 0;
  WHILE i < BlockSize DO
    c := [DS:SI];
    IF c # 0 THEN RETURN FALSE END;
    INC(SI);
    INC(i)
  END;
  RETURN TRUE
END IsZeroBlock;

(* ParseOctal*: parse an up-to-len-byte octal ASCII field (NUL or space
   terminated/padded, as USTAR writes it) starting at ptr, into a
   genuine LONGINT (lo/hi WORD pair, RETURNed as DX:AX -- register-pair
   convention, DOCS/SPHINX.MD S11). Stops at the first non-octal-digit
   byte or after len bytes, whichever comes first. Shifting a lo/hi
   pair left by 3 bits (SHL 3) each digit: the 3 bits shifted OUT of
   lo's own top become lo's own current top 3 bits shifted right by
   13 (WORD-lo SHR (16-3)) into hi's own bottom, same "carry via a
   second shift the opposite direction" idiom LZSSLIB.SMD's own
   register-pair helpers already use elsewhere in this tree. *)
PROCEDURE ParseOctal*(ptr : WORD; len : WORD) : LONGINT; NEAR;
USES SI;
VAR i, digit, nLo, nHi, carry : WORD; c : BYTE;
BEGIN
  SI := ptr;
  i := 0;
  nLo := 0; nHi := 0;
  WHILE i < len DO
    c := [DS:SI];
    IF c < '0' THEN BREAK END;
    IF c > '7' THEN BREAK END;
    digit := c;
    DEC(digit, '0');
    AX := nLo;
    CL := 13;
    AX := AX SHR CL;
    carry := AX;
    CL := 3;
    nLo := nLo SHL CL;
    nHi := nHi SHL CL;
    INC(nHi, carry);
    INC(nLo, digit);
    INC(SI);
    INC(i)
  END;
  AX := nLo; DX := nHi;
  RETURN DX:AX
END ParseOctal;

(* FormatOctal*: write val (a genuine LONGINT lo/hi pair) as an
   (len-1)-digit zero-padded octal field at ptr, followed by a
   trailing NUL in the field's own last byte (matching how GNU/POSIX
   tar itself terminates the size field) -- len is the field's own
   full width (e.g. 12 for the size field), so len-1 octal digits are
   actually written. Shifting the lo/hi pair right by 3 bits each
   digit: hi's own bottom 3 bits shifted out become lo's own new top 3
   bits (via hi SHL 13, the opposite-direction counterpart to
   ParseOctal's own carry above), same register-pair SHR idiom. *)
PROCEDURE FormatOctal*(ptr : WORD; len : WORD; valLo, valHi : WORD); NEAR;
USES SI;
VAR i, ndigits, pos, carry : WORD; digit : BYTE;
BEGIN
  ndigits := len;
  DEC(ndigits);
  SI := ptr;
  INC(SI, ndigits);
  AL := 0;
  [DS:SI] := AL;
  pos := ndigits;
  WHILE pos > 0 DO
    DEC(pos);
    digit := valLo;
    digit := digit & 7;
    AL := digit;
    INC(AL, '0');
    SI := ptr;
    INC(SI, pos);
    [DS:SI] := AL;
    AX := valHi;
    CL := 13;
    AX := AX SHL CL;
    carry := AX;
    CL := 3;
    valLo := valLo SHR CL;
    valHi := valHi SHR CL;
    valLo := valLo OR carry
  END
END FormatOctal;

(* Error*: TARPAK.SMD's/TARUNPAK.SMD's own former identical usage-error
   reporter. *)
PROCEDURE Error*(msg : WORD); NEAR;
BEGIN
  Out_String(msg); Out_Ln; Halt(1)
END Error;

(* PadTo512*: write (512 - (len MOD 512)) MOD 512 zero bytes to fp --
   rounds fp's own cursor up to the next 512-byte boundary, assuming it
   currently sits exactly len bytes past the last boundary (the
   caller's own responsibility to track). len is a genuine LONGINT
   (lo/hi pair, DOCS/TRBUG.MD) but only its own low 9 bits (& 511) are
   ever needed here -- lenHi never affects the result, taken as a
   parameter only so every call site can pass the same lo/hi pair
   uniformly. A no-op if len is already a multiple of 512. zeroBlockPtr
   is the caller's own ADR(zeroBlock) (a 512-byte all-zero buffer) --
   kept as a parameter rather than a TARLIB-owned buffer since both
   TARPAK.SMD and TARUNPAK.SMD also use their own zeroBlock directly
   elsewhere (writing the archive's own trailing two all-zero blocks),
   so it has to stay a caller-owned VAR either way. *)
PROCEDURE PadTo512*(fp : WORD; lenLo, lenHi : WORD; zeroBlockPtr : WORD); NEAR;
VAR rem, need : WORD;
BEGIN
  rem := lenLo;
  rem := rem & 511;
  IF rem = 0 THEN RETURN END;
  need := 512;
  DEC(need, rem);
  BlockWrite(fp, zeroBlockPtr, need)
END PadTo512;

(* SkipTo512*: like PadTo512*, but SEEKS fp forward instead of writing
   -- used to skip a member's own trailing pad bytes without copying
   them. Same "only the low 9 bits of len matter" note as PadTo512*
   above -- lenHi taken only for a uniform lo/hi call signature. No
   caller-owned buffer needed here (unlike PadTo512, above), so no
   extra pointer parameter. *)
PROCEDURE SkipTo512*(fp : WORD; lenLo, lenHi : WORD); NEAR;
VAR rem, need, newLo, newHi : WORD; newPos : LONGINT;
BEGIN
  rem := lenLo;
  rem := rem & 511;
  IF rem = 0 THEN RETURN END;
  need := 512;
  DEC(need, rem);
  FilePos(fp);
  newLo := AX; newHi := DX;
  INC(newLo, need);
  IF CFLAG THEN INC(newHi) END;
  AX := newLo; DX := newHi;
  newPos := DX:AX;
  DX:AX := newPos;
  Seek(fp, DX:AX)
END SkipTo512;

(* CopyRaw*: copy exactly len (a genuine LONGINT lo/hi pair) bytes from
   the file at inFp to the file at outFp unchanged, in chunkSize-sized
   pieces -- remLo/remHi's own borrow-decrement loop uses the same
   idiom LZSSLIB.SMD's own OutByte/remLo/remHi already establishes
   elsewhere in this tree. copyBufPtr is the caller's own
   ADR(copyBuf), a chunkSize-byte scratch buffer; chunkSize is the
   caller's own CopyChunk constant (512 in both current callers, taken
   as a parameter rather than hardcoded here so this stays a pure
   function of what the caller passes, not an assumption about their
   own buffer's real declared size). *)
PROCEDURE CopyRaw*(lenLo, lenHi : WORD; inFp, outFp : WORD;
                    copyBufPtr : WORD; chunkSize : WORD); NEAR;
VAR remLo, remHi, want, got : WORD; remZero : BOOLEAN;
BEGIN
  remLo := lenLo; remHi := lenHi;
  remZero := FALSE;
  IF remLo = 0 THEN
    IF remHi = 0 THEN remZero := TRUE END
  END;
  WHILE ~remZero DO
    want := chunkSize;
    IF remHi = 0 THEN
      IF want > remLo THEN want := remLo END
    END;
    got := BlockRead(inFp, copyBufPtr, want);
    IF got = 0 THEN RETURN END;
    BlockWrite(outFp, copyBufPtr, got);
    AX := remLo;
    DEC(AX, got);
    IF CFLAG THEN DEC(remHi) END;
    remLo := AX;
    remZero := FALSE;
    IF remLo = 0 THEN
      IF remHi = 0 THEN remZero := TRUE END
    END
  END
END CopyRaw;

(* IsLongZero*: TRUE if the (lo, hi) LONGINT pair is exactly 0 -- moved
   here from TARPAK.SMD's/TARUNPAK.SMD's own identical copies (own
   local copy of LZPLIB.SMD's own internal IsZero, not *-exported
   there, so not part of that module's own API/.SHD -- this tree's
   convention is that the nested-IF idiom below, not that internal
   helper, is what a caller uses; LZSSLIB.SMD's own remZero logic
   already establishes the same pattern, DOCS/SPHINX.MD S7.4: no
   assignable &/OR boolean expression). *)
PROCEDURE IsLongZero*(lo, hi : WORD) : BOOLEAN; NEAR;
BEGIN
  IF lo = 0 THEN
    IF hi = 0 THEN RETURN TRUE END
  END;
  RETURN FALSE
END IsLongZero;

(* ClearChksumField*: overwrite the header at hdrPtr's own 8-byte
   chksum field with ASCII spaces, USTAR's own defined convention for
   computing a header's checksum (HeaderChecksum* treats those 8 bytes
   as spaces regardless, but the field must ALSO really hold spaces in
   the header actually written out, per the format). *)
PROCEDURE ClearChksumField*(hdrPtr : WORD); NEAR;
VAR i : WORD;
BEGIN
  BX := hdrPtr;
  SI := ADR([DS:BX].TarHeader.chksum);
  i := 0;
  WHILE i < 8 DO
    AL := 32;
    [DS:SI] := AL;
    INC(SI);
    INC(i)
  END
END ClearChksumField;

(* HeaderChecksum*: sum of all 512 header bytes, with the chksum field
   itself (8 bytes) treated as ASCII spaces for the purpose of the sum
   (USTAR's own defined algorithm) -- returned as a plain WORD (the
   real sum never exceeds 512*255=130560, but only the low 16 bits are
   ever compared/stored here, matching every other WORD-only value in
   this file; TarHeader.chksum's own 6-digit octal field can represent
   up to 262143 unsigned, well past what a real 512-byte header sums
   to, so the WORD truncation never actually loses information for a
   genuine header). *)
PROCEDURE HeaderChecksum*(hdrPtr : WORD) : WORD; NEAR;
USES SI;
VAR i, sum, chkEnd : WORD; c : BYTE;
BEGIN
  chkEnd := ChksumOfs;
  INC(chkEnd, 8);
  sum := 0;
  SI := hdrPtr;
  i := 0;
  WHILE i < BlockSize DO
    IF i >= ChksumOfs THEN
      IF i < chkEnd THEN
        INC(sum, 32)   (* ' ' *)
      ELSE
        c := [DS:SI];
        INC(sum, c)
      END
    ELSE
      c := [DS:SI];
      INC(sum, c)
    END;
    INC(SI);
    INC(i)
  END;
  RETURN sum
END HeaderChecksum;

END TARLIB.
