(* TARPAK - read a USTAR tar file, write a structurally similar tar
   file whose regular-file members have their own content compressed
   via LZPLIB.SMD's lzp_compress_fp* (RFC1978 PPP Predictor Compression
   Protocol, EXAMPLES/LZSS/LZP.SMD's own algorithm -- reused directly
   via IMPORT, not reimplemented). Non-regular entries (directories,
   symlinks, etc. -- any typeflag other than '0'/NUL) and zero-length
   regular files pass through byte-for-byte unchanged.

   Usage: TARPAK in.tar out.tar

   A tar member's own header size field must be written BEFORE its
   content, but the real compressed size is only known AFTER
   compressing -- handled by writing a placeholder header, compressing
   straight into the output (advancing its cursor), then Seek-ing back
   to patch just the header's size+chksum fields with the real values
   once they're known, then Seek-ing forward again past the (now
   padded) content to continue with the next member.

   Member size (origSize/compSize) is tracked as a genuine LONGINT
   (lo/hi WORD pair, DOCS/TRBUG.MD) -- TARLIB.SMD's own ParseOctal*/
   FormatOctal* and LZPLIB.SMD's own lzp_compress_fp* all take/return a
   real 32-bit size now, not a WORD-truncated one. BlockRead/BlockWrite
   themselves are still WORD-per-call (CopyRaw's own CopyChunk-sized
   pieces), so content is still copied/compressed in bounded chunks --
   only the per-member TOTAL size is no longer capped at 65535 bytes.
   Output is written to a NEW file (outName) -- only that file is ever
   created; there is no temp/scratch file. *)

MODULE TARPAK;

IMPORT SYSTEM, FILES, OUT, TARLIB, LZPLIB, CMDLINE;

CONST
  MaxName = 128;
  CopyChunk = 512;

VAR
  inName, outName : BYTE[MaxName];
  cmdState : CmdState;

  inF, outF : File;
  hdr : TarHeader;
  zeroBlock : BYTE[512];
  copyBuf : BYTE[CopyChunk];

  n : WORD;
  typeflag : BYTE;
  isRegular : BOOLEAN;
  done : BOOLEAN;
  origLo, origHi, compLo, compHi : WORD;
  curLo, curHi, chk : WORD;
  headerPos, curPos : LONGINT;
  outFp : WORD;

(* SkipBlanks/GetToken/Error/PadTo512/SkipTo512/CopyRaw/IsLongZero/
   ClearChksumField all moved to TARLIB.SMD -- this file's own copies
   were byte-for-byte identical to TARUNPAK.SMD's, a real duplication
   risk despite TARLIB.SMD already existing as their shared module.
   TARLIB itself no longer carries its own separate GetTokenPlain/
   SkipBlanksPlain/StartTarCmdLine/TarCmdState -- this file now
   IMPORTs LIB/CMDLINE.SMD directly and uses its own CmdState/
   StartCmdLine/SkipBlanks/GetToken, the same shared primitives
   MKCRK.SMD/APPLYCRK.SMD/LZSS.SMD/LZP.SMD/MIME.SMD/LCOUNT.SMD/
   SMDFMT.SMD all already use, instead of a second, TARPAK-specific
   command-line module. CMDLINE.GetToken is quote-aware, a strict
   superset of what this file's own former no-quote scanner needed
   (neither "in.tar" nor "out.tar" realistically starts with a
   literal '"'). cmdState replaces this file's former
   cmdIdx/cmdTailLen locals. *)
PROCEDURE ParseCmdLine() : BOOLEAN; NEAR;
USES ES;
BEGIN
  StartCmdLine(ADR(cmdState));
  SkipBlanks(ADR(cmdState));
  IF ~GetToken(ADR(cmdState), ADR(inName), MaxName) THEN RETURN FALSE END;
  SkipBlanks(ADR(cmdState));
  IF ~GetToken(ADR(cmdState), ADR(outName), MaxName) THEN RETURN FALSE END;
  RETURN TRUE
END ParseCmdLine;

BEGIN
  IF ~ParseCmdLine() THEN Error("usage: TARPAK in.tar out.tar") END;
  IF ~Reset(ADR(inF), ADR(inName)) THEN Error("cannot open input tar") END;
  IF ~ReWrite(ADR(outF), ADR(outName)) THEN Error("cannot create output tar") END;

  AL := 0;
  DI := ADR(zeroBlock);
  CX := 512;
  PUSH(DS);
  POP(ES);
  SetDFlag(FALSE);
  STOREB(TRUE);

  done := FALSE;
  WHILE ~done DO
    n := BlockRead(ADR(inF), ADR(hdr), 512);
    IF n < 512 THEN done := TRUE; BREAK END;
    IF IsZeroBlock(ADR(hdr)) THEN done := TRUE; BREAK END;

    BX := ADR(hdr);
    typeflag := [DS:BX].TarHeader.typeflag;
    BX := ADR(hdr);
    DX:AX := ParseOctal(ADR([DS:BX].TarHeader.size), 12);
    origLo := AX; origHi := DX;

    headerPos := FilePos(ADR(outF));
    BlockWrite(ADR(outF), ADR(hdr), 512);

    isRegular := FALSE;
    IF typeflag = 0 THEN isRegular := TRUE END;
    IF typeflag = '0' THEN isRegular := TRUE END;

    IF isRegular THEN
      IF ~IsLongZero(origLo, origHi) THEN
        curPos := FilePos(ADR(outF));
        curLo := AX; curHi := DX;
        lzp_compress_fp(ADR(inF), ADR(outF), origLo, origHi);
        curPos := FilePos(ADR(outF));
        compLo := AX; compHi := DX;
        AX := compLo; DEC(AX, curLo);
        IF CFLAG THEN DEC(compHi) END;
        compLo := AX;
        DEC(compHi, curHi);
        PadTo512(ADR(outF), compLo, compHi, ADR(zeroBlock));

        curPos := FilePos(ADR(outF));

        outFp := ADR(outF);
        DX:AX := headerPos;
        Seek(outFp, DX:AX);
        BX := ADR(hdr);
        FormatOctal(ADR([DS:BX].TarHeader.size), 12, compLo, compHi);
        ClearChksumField(ADR(hdr));
        chk := HeaderChecksum(ADR(hdr));
        BX := ADR(hdr);
        FormatOctal(ADR([DS:BX].TarHeader.chksum), 8, chk, 0);
        BlockWrite(ADR(outF), ADR(hdr), 512);

        DX:AX := curPos;
        Seek(outFp, DX:AX);
        SkipTo512(ADR(inF), origLo, origHi)
      END
    ELSE
      IF ~IsLongZero(origLo, origHi) THEN
        CopyRaw(origLo, origHi, ADR(inF), ADR(outF), ADR(copyBuf), CopyChunk);
        PadTo512(ADR(outF), origLo, origHi, ADR(zeroBlock));
        SkipTo512(ADR(inF), origLo, origHi)
      END
    END
  END;

  BlockWrite(ADR(outF), ADR(zeroBlock), 512);
  BlockWrite(ADR(outF), ADR(zeroBlock), 512);

  Close(ADR(inF));
  Close(ADR(outF));
  Halt(0)
END TARPAK.
